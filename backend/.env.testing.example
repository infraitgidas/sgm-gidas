APP_ENV=testing
LOG_LEVEL=WARNING
LOG_FORMAT=text
SERVICE_NAME=gidas-backend
APP_VERSION=testing
SECRET_KEY=change-me-testing
JWT_SECRET=change-me-testing
REFRESH_SECRET=change-me-testing
JWT_ISSUER=auth-service
JWT_AUDIENCE=
FRONTEND_URL=http://localhost:8080
FRONTEND_URLS=http://localhost:8080,http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@db:5432/gidas_testing_db
SQLALCHEMY_TRACK_MODIFICATIONS=False
JWT_EXPIRATION_MINUTES=60
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=120 per minute
AUTH_LOGIN_LIMIT=10 per minute
AUTH_REFRESH_LIMIT=30 per minute
AUTH_REGISTER_LIMIT=5 per hour
AUTH_CHANGE_PASSWORD_LIMIT=10 per hour
# Configurar secretos distintos y compartidos por API/worker antes de probar correo.
EMAIL_OUTBOX_ENCRYPTION_KEY=
PASSWORD_RESET_HMAC_KEY=
PASSWORD_RESET_PUBLIC_URL=http://localhost/restablecer-password
SMTP_TLS_MODE=none
SMTP_TIMEOUT_SECONDS=20
EMAIL_WORKER_POLL_SECONDS=5
PASSWORD_RESET_REQUEST_IP_LIMIT=5 per 15 minutes
PASSWORD_RESET_REQUEST_EMAIL_LIMIT=3 per hour
PASSWORD_RESET_CONFIRM_LIMIT=10 per 15 minutes
EXPORT_LIMIT=10 per hour
SEARCH_LIMIT=90 per minute
SEARCH_MAX_QUERY_LENGTH=80
SEARCH_MAX_PER_PAGE=50
SEARCH_MAX_SCAN_PER_MODEL=300
PAGINATION_DEFAULT_PER_PAGE=9
PAGINATION_MAX_PER_PAGE=100
