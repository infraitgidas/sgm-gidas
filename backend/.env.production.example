APP_ENV=production
# Para calificacion temporal por HTTP en una VM sin TLS, usar APP_ENV=staging.
# Nunca usar staging como sustituto de HTTPS con datos reales.
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=gidas-backend
APP_VERSION=replace-with-release-version
SECRET_KEY=replace-with-secure-secret
JWT_SECRET=replace-with-secure-secret
REFRESH_SECRET=replace-with-secure-secret
# Alternativa recomendada con archivos montados:
# SECRET_KEY_FILE=/run/secrets/flask_secret_key
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# REFRESH_SECRET_FILE=/run/secrets/refresh_secret
JWT_ISSUER=auth-service
JWT_AUDIENCE=gidas-api
# Reemplazar por el origen HTTPS exacto provisto por el laboratorio, sin ruta ni
# slash final. Incluir :puerto solo si HTTPS no utiliza el puerto 443.
FRONTEND_URL=https://gidas.laboratorio.example
FRONTEND_URLS=https://gidas.laboratorio.example
DATABASE_URL=postgresql://gidas_app:replace-with-secure-app-password@db:5432/gidas_db
SQLALCHEMY_TRACK_MODIFICATIONS=False
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_MINUTES=10080
SESSION_WARNING_SECONDS=300
REFRESH_SESSION_RETENTION_DAYS=30
# Mantener False hasta validar certificado, cadena, DNS y navegacion por HTTPS.
# Activar True solamente despues de completar el checklist de despliegue.
HSTS_ENABLED=False
HSTS_MAX_AGE=31536000
RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_DEFAULT=120 per minute
MAX_CONTENT_LENGTH=10485760
MAX_JSON_CONTENT_LENGTH=1048576
AUTH_LOGIN_LIMIT=10 per minute
AUTH_REFRESH_LIMIT=30 per minute
AUTH_REGISTER_LIMIT=5 per hour
AUTH_CHANGE_PASSWORD_LIMIT=10 per hour
EXPORT_LIMIT=10 per hour
SEARCH_LIMIT=90 per minute
SEARCH_MAX_QUERY_LENGTH=80
SEARCH_MAX_PER_PAGE=50
SEARCH_MAX_SCAN_PER_MODEL=300
PAGINATION_DEFAULT_PER_PAGE=9
PAGINATION_MAX_PER_PAGE=100
BCRA_API_BASE_URL=https://api.bcra.gob.ar/estadisticas/v4.0
BCRA_RETAIL_EXCHANGE_RATE_VARIABLE_ID=4
BCRA_RETAIL_EXCHANGE_RATE_SERIES=7927
BCRA_EXCHANGE_RATE_DESCRIPTION_TOKENS=tipo de cambio minorista,vendedor
BCRA_EXCHANGE_RATE_METHODOLOGY_TOKENS=9791
BCRA_SYNC_LOOKBACK_DAYS=7
BCRA_REQUEST_TIMEOUT_SECONDS=10
