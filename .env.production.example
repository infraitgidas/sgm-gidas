COMPOSE_SERVICE_PREFIX=gidas_prod
COMPOSE_NETWORK=gidas_prod_network
POSTGRES_VOLUME=gidas_prod_postgres_data
POSTGRES_DB=gidas_db
POSTGRES_ADMIN_USER=gidas_admin
POSTGRES_ADMIN_PASSWORD=replace-with-secure-admin-password
POSTGRES_APP_USER=gidas_app
POSTGRES_APP_PASSWORD=replace-with-secure-app-password
MIGRATION_DATABASE_URL=postgresql://gidas_admin:replace-with-secure-admin-password@db:5432/gidas_db
# 127.0.0.1 permite que cloudflared, instalado en el host, alcance el proxy sin
# publicar el puerto a la LAN. Tambien sirve para un Nginx TLS externo en el host.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
# Variables de referencia para completar nginx/gidas.external.conf.example.
# No son consumidas automaticamente por Nginx: reemplazar los placeholders de la
# plantilla al provisionar el host. No guardar certificados dentro del repositorio.
# GIDAS_SERVER_NAME=gidas.laboratorio.example
# GIDAS_HTTP_PORT=80
# GIDAS_HTTPS_PORT=443
# GIDAS_TLS_CERTIFICATE_PATH=/etc/nginx/tls/gidas/fullchain.pem
# GIDAS_TLS_CERTIFICATE_KEY_PATH=/etc/nginx/tls/gidas/privkey.pem
BACKEND_ENV_FILE=.env.production
VITE_APP_ENV=production
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api
VITE_SERVER_FILTER_PERSONAL=true
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
